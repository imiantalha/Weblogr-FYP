Options -Indexes

<FilesMatch "^\.env|^\.git|^(composer\.json|composer\.lock|SECURITY\.md)$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:database|includes|registration/vendor|registration/smtp)(?:/|$) - [F,L,NC]

# Public publishing routes.
RewriteRule ^read/([0-9]+)/([^/]+)/?$ article.php?id=$1&slug=$2 [L,QSA]
RewriteRule ^author/([0-9]+)/([^/]+)/?$ author.php?id=$1&slug=$2 [L,QSA]
RewriteRule ^discover/?$ blog.php [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    <FilesMatch "\.(?:css|js|svg|png|jpg|jpeg|gif|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>
</IfModule>
