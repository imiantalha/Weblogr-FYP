Options -Indexes

<FilesMatch "^\.env|^\.git|^(composer\.json|composer\.lock|SECURITY\.md)$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:database|includes|registration/vendor|registration/smtp)(?:/|$) - [F,L,NC]

# Serve the Weblogr brand mark as the default browser favicon for every page,
# including legacy pages that do not explicitly declare a favicon link.
RewriteRule ^favicon\.ico$ assets/weblogr-mark.svg [L]
RewriteRule ^favicon\.svg$ assets/weblogr-mark.svg [L]

# Public publishing routes.
RewriteRule ^read/([0-9]+)/([^/]+)/?$ article.php?id=$1&slug=$2 [L,QSA]
RewriteRule ^author/([0-9]+)/([^/]+)/?$ author.php?id=$1&slug=$2 [L,QSA]
RewriteRule ^discover/?$ blog.php [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Application-level 404 handling.
# Existing files/directories continue to be served normally; only unresolved
# application URLs are sent to the branded 404 controller. This avoids Apache's
# ErrorDocument recursion and keeps the response under Weblogr's own UI.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    <FilesMatch "\.(?:css|js|svg|png|jpg|jpeg|gif|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>
</IfModule>
