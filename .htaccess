Options -Indexes

# Never expose environment files or repository metadata.
<FilesMatch "^\.env|^\.git|^(composer\.json|composer\.lock|SECURITY\.md)$">
    Require all denied
</FilesMatch>

# Internal configuration and dependency source must not be browsable.
RewriteEngine On
RewriteRule ^(?:database|includes|registration/vendor|registration/smtp)(?:/|$) - [F,L,NC]

# Add baseline browser protections where Apache allows headers.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Static assets are versioned by Git changes, so they can be cached safely.
    <FilesMatch "\.(?:css|js|svg|png|jpg|jpeg|gif|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>
</IfModule>
